{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PodFlow AI Studio",
  "version": "0.1.0",
  "identifier": "com.podflow.multicam",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PodFlow AI Studio - MultiCam Director",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-TW"
      },
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
